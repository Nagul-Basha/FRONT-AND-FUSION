* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial;
}

/* 🌈 Animated Background */
body {
    background: linear-gradient(270deg, #4facfe, #00f2fe, #6a11cb);
    background-size: 400% 400%;
    animation: bgMove 12s ease infinite;
    color: #111;
}

/* 🌙 Dark Mode */
body.dark {
    background: #0f172a;
    color: white;
}

/* MENU BUTTON */
.menu-btn {
    position: fixed;
    top: 15px;
    right: 15px;
    font-size: 26px;

    /* Glass */
    background: rgba(255,255,255,0.7);
    backdrop-filter: blur(10px);

    padding: 10px 14px;
    border-radius: 20px;
    cursor: pointer;
    z-index: 1000;
    transition: 0.3s;
}
.menu-btn:hover {
    transform: scale(1.1);
}

/* SIDE MENU */
.side-menu {
    position: fixed;
    top: 0;
    right: -320px;
    width: 300px;
    height: 100%;

    /* Glass */
    background: rgba(255,255,255,0.75);
    backdrop-filter: blur(15px);

    box-shadow: -5px 0 25px rgba(0,0,0,0.3);
    padding: 20px;
    transition: 0.4s ease;
    overflow-y: auto;
    z-index: 1001;
}

body.dark .side-menu {
    background: rgba(20,20,30,0.85);
}

.side-menu.active {
    right: 0;
}

/* SIDE MENU BUTTONS */
.side-menu button {
    width: 100%;
    margin-bottom: 10px;
    padding: 12px;
    border: none;
    background: linear-gradient(90deg,#4facfe,#00f2fe);
    color: white;
    border-radius: 18px;
    cursor: pointer;
    transition: 0.3s;
}
.side-menu button:hover {
    transform: translateY(-2px) scale(1.02);
    box-shadow: 0 0 10px #4facfe;
}

/* OVERLAY (MENU FIX) */
.overlay {
    position: fixed;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.4);
    top: 0;
    left: 0;
    opacity: 0;
    pointer-events: none;
    transition: 0.3s;
    z-index: 900;
}
.overlay.active {
    opacity: 1;
    pointer-events: all;
}

/* HISTORY */
.history-item {
    background: rgba(255,255,255,0.6);
    padding: 10px;
    margin-bottom: 8px;
    border-radius: 12px;
    font-size: 13px;
    backdrop-filter: blur(10px);
}

body.dark .history-item {
    background: rgba(255,255,255,0.1);
}

/* WELCOME */
.welcome {
    height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
}

.welcome-box {
    background: rgba(255,255,255,0.75);
    backdrop-filter: blur(20px);
    padding: 40px;
    border-radius: 20px;
    text-align: center;
    animation: fadeIn 0.8s ease;
}

body.dark .welcome-box {
    background: rgba(20,20,30,0.8);
}

/* BUTTON */
.start-btn {
    margin-top: 15px;
    padding: 12px 22px;
    background: linear-gradient(90deg,#4facfe,#00f2fe);
    border: none;
    color: white;
    border-radius: 20px;
    transition: 0.3s;
}
.start-btn:hover {
    transform: scale(1.1);
    box-shadow: 0 0 15px #4facfe;
}

/* APP */
.main-app {
    display: none;
    height: 100vh;
    justify-content: center;
    align-items: center;
}

/* CARD */
.card {
    width: 400px;

    /* Glass */
    background: rgba(255,255,255,0.75);
    backdrop-filter: blur(20px);

    border-radius: 22px;
    padding: 20px;
    animation: fadeIn 0.5s ease;
}

body.dark .card {
    background: rgba(20,20,30,0.85);
}

/* Gradient Title */
h2 {
    background: linear-gradient(90deg,#00f2fe,#4facfe);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

/* MODE TEXT */
.mode {
    font-size: 12px;
    margin-bottom: 10px;
    color: gray;
}

/* TEXTAREA */
.chat-input, .chat-output {
    width: 100%;
    min-height: 40px;
    max-height: 160px;
    padding: 12px;
    margin-bottom: 10px;
    border-radius: 16px;
    border: 1px solid rgba(255,255,255,0.3);
    resize: none;
    overflow-y: auto;

    background: rgba(255,255,255,0.6);
    backdrop-filter: blur(10px);
}

body.dark .chat-input,
body.dark .chat-output {
    background: rgba(255,255,255,0.1);
    color: white;
}

/* SELECT */
select {
    width: 100%;
    margin-bottom: 10px;
    padding: 10px;
    border-radius: 16px;
    border: none;

    background: rgba(255,255,255,0.6);
    backdrop-filter: blur(10px);
}

body.dark select {
    background: rgba(255,255,255,0.1);
    color: white;
}

/* BUTTONS */
.btn {
    width: 100%;
    padding: 12px;
    margin-top: 5px;
    background: linear-gradient(90deg,#6a11cb,#2575fc);
    color: white;
    border: none;
    border-radius: 20px;
    transition: 0.3s;
}
.btn:hover {
    transform: translateY(-2px) scale(1.03);
    box-shadow: 0 0 15px #6a11cb;
}

.row {
    display: flex;
    gap: 10px;
}

.small-btn {
    flex: 1;
    padding: 12px;
    border-radius: 20px;
    border: none;
    color: white;
    background: linear-gradient(90deg,#4facfe,#00f2fe);
    transition: 0.3s;
}
.small-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 10px #00f2fe;
}

/* COLORS */
.mic {
    background: linear-gradient(90deg,#ff416c,#ff4b2b);
}

.ai-btn {
    background: linear-gradient(90deg,#00c853,#00e676);
}

/* ✨ Animations */
@keyframes fadeIn {
    from {opacity: 0; transform: translateY(20px);}
    to {opacity: 1; transform: translateY(0);}
}

@keyframes bgMove {
    0% {background-position: 0% 50%;}
    50% {background-position: 100% 50%;}
    100% {background-position: 0% 50%;}
}
